  {
    "pluginAlias": "homebridge-plex-metadata",
    "pluginType": "platform",
    "singular": true,
    "schema": {
      "type": "object",
      "required": [
        "plexHost",
        "plexPort",
        "plexToken",
        "players"
      ],
      "properties": {
        "name": {
          "title": "Plugin Name",
          "type": "string",
          "default": "Plex Sensors"
        },
        "plexHost": {
          "title": "Plex Host",
          "type": "string",
          "description": "Plex host, e.g. 192.168.1.10",
          "format": "hostname"
        },
        "plexPort": {
          "title": "Plex Port",
          "type": "number",
          "description": "Plex port, e.g. 32400",
          "default": 32400
        },
        "plexToken": {
          "title": "Plex Token",
          "type": "string",
          "description": "Plex authentication token"
        },
        "players": {
          "title": "Players",
          "type": "array",
          "items": {
              "title": "Player Info",
              "type": "object",
              "properties": {
                  "name": {
                      "title": "Player Name",
                      "type": "string"      
                  },
                  "uuid": {
                      "title": "Player UUID",
                      "type": "string"      
                  },
                  "stopAtCredits": {
                      "title": "Turn Sensor Off At Credits",
                      "type": "boolean",
                      "default": false,
                      "description": "Turn the player's occupancy sensor off when playback reaches the first detected credits marker."
                  },
                  "creditsOffsetSeconds": {
                      "title": "Credits Offset (seconds)",
                      "type": "number",
                      "default": 0,
                      "description": "Adjust when the sensor turns off. Use a negative value to trigger before credits and a positive value to trigger after credits begin.",
                      "condition": {
                          "functionBody": "return model.players && model.players[arrayIndices[0]] && model.players[arrayIndices[0]].stopAtCredits === true;"
                      }
                  }
              }
          }
        },
        "pollIntervalSeconds": {
          "title": "Polling Interval (seconds)",
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "How often to update playback position. Five seconds is recommended when using credits detection."
        },
      "enableWebhooks": {
          "title": "Enable Webhooks",
          "type": "boolean"
        },
        "plexWebhookPort": {
          "title": "Plex Webhook Port",
          "type": "integer",
          "default": 32500,
          "condition": {
              "functionBody": "return model.enableWebhooks === true;"
          }
        }
      }
    }
  }
