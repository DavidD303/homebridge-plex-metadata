  {
    "pluginAlias": "homebridge-plex-metadata",
    "pluginType": "platform",
    "singular": true,
    "schema": {
      "type": "object",
      "properties": {
        "plexHost": {
          "title": "Plex Host",
          "type": "string",
          "description": "Plex host, e.g. 192.168.1.10",
          "format": "hostname",
          "required": true
        },
        "plexPort": {
          "title": "Plex Port",
          "type": "number",
          "description": "Plex port, e.g. 32400",
          "default": 32400,
          "required": true
        },
        "plexToken": {
          "title": "Plex Token",
          "type": "string",
          "description": "Plex authentication token",
          "required": true
        },
        "players": {
          "title": "Players",
          "type": "array",
          "items": {
              "title": "Player Info",
              "type": "object",
              "properties": {
                  "name": {
                      "title": "Player Name",
                      "type": "string"      
                  },
                  "uuid": {
                      "title": "Player UUID",
                      "type": "string"      
                  }
              }
          }
        },
      "enableWebhooks": {
          "title": "Enable Webhooks",
          "type": "boolean"
        },
        "plexWebhookPort": {
          "title": "Plex Webhook Port",
          "type": "integer",
          "default": 32500,
          "condition": {
              "functionBody": "return model.enableWebhooks === true;"
          }
        }
      }
    }
  }